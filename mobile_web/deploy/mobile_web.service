[Unit]
Description=Mobile web shopping guide
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Replace User, Group, WorkingDirectory, WEB_CONFIG_FILE and ExecStart together
# if you use a different account or installation path.
User=mobileweb
Group=mobileweb
WorkingDirectory=/opt/mobile_web
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# All service configuration is read directly from /opt/mobile_web/config.local.json.
# Single worker, no reload. Do not use a shell or activate the virtualenv.
ExecStart=/opt/mobile_web/.venv/bin/python /opt/mobile_web/run.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# File logging is disabled above. To enable it, create a writable runtime/logs
# directory, set WEB_LOG_DIR, and allow ONLY that directory with ReadWritePaths.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mobile_web

[Install]
WantedBy=multi-user.target
